# ===== متغيرات الواجهة (تُكشف للمتصفح — آمنة) =====
# من Supabase Dashboard ← Project Settings ← API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ===== لا تضع المفاتيح السرية هنا =====
# SUPABASE_SERVICE_ROLE_KEY لا يوضع في أي ملف داخل المشروع ولا في Vercel.
# دوال Supabase Edge تحصل عليه تلقائياً من بيئة Supabase.
# الأسرار الخاصة بالدوال تُضبط عبر:  npx supabase secrets set NAME=VALUE
